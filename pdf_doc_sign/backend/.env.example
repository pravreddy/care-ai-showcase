# ============================================================
# DocSign UK - Environment Configuration
# Operated by Avyangah Technologies Limited (08235853)
# ============================================================

# --- App ---
DEBUG=True
SECRET_KEY=change-me-to-random-64-chars
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
DB_NAME=docsign_uk
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# --- Redis ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# --- S3-Compatible Storage ---
# PeaSoup UK (recommended): UK data residency, £4.99/TB, no egress fees
# Get credentials from: peasoup.cloud
USE_S3=False
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=signsimple-docs
S3_REGION=uk-1
S3_ENDPOINT_URL=https://s3.peasoup.cloud
S3_USE_SSL=True

# ============================================================
# AI Services (Groq — FREE, 14,400 requests/day)
# ============================================================
# Groq is used for:
#   1. AI Content Detection (ai_detector app)
#   2. Chatbot (chatbot app — coming soon)
#   3. Document summarisation (future)
#
# Get your FREE key at: https://console.groq.com/keys
# No credit card needed. 14,400 requests/day on free tier.

GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Default AI detector provider: groq (recommended) | huggingface | grok | openai
DEFAULT_AI_DETECTOR_PROVIDER=groq

# HuggingFace (free but unreliable — models get retired)
HF_API_TOKEN=

# Grok / xAI (paid — optional)
GROK_API_KEY=
GROK_MODEL=grok-3-mini

# OpenAI (paid — optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Payment Providers
# ============================================================

# --- TrueLayer (Open Banking — Pay by Bank) ---
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_WEBHOOK_SECRET=
TRUELAYER_MERCHANT_ACCOUNT_ID=
TRUELAYER_SANDBOX=True

# --- Stripe (Card payments — fallback) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_EXTRA_DOCS=

# ============================================================
# OAuth Providers
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- OAuth Frontend Callback ---
OAUTH_FRONTEND_CALLBACK_URL=http://localhost:3001/oauth/callback

# --- Email ---
# For now: console backend (dev) or Brevo SMTP (staging)
# Later: Postal (self-hosted)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@signsimple.co.uk

# Postal (when ready):
# EMAIL_HOST=postal.avyangah.co.uk
# EMAIL_PORT=25
# EMAIL_HOST_USER=smtp_username
# EMAIL_HOST_PASSWORD=smtp_password
