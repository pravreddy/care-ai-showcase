# ============================================================
# Care AI Engine - Environment Configuration
# ============================================================
# Copy this to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# --- Application ---
APP_NAME=CareAI Engine
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000
APP_HOST=0.0.0.0
APP_VERSION=1.0.0
SECRET_KEY=change-me-to-a-random-64-char-string
ALLOWED_ORIGINS=https://yourdomain.co.uk,https://app.yourdomain.co.uk

# --- OAuth / Social Login ---
# Get these from Google Cloud Console:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create an OAuth 2.0 Client ID (Web application)
#   3. Add your callback URL to "Authorized redirect URIs"
#
# For LOCAL development:
#   GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
#
# For PRODUCTION:
#   GOOGLE_REDIRECT_URI=https://yourdomain.co.uk/api/v1/auth/google/callback
#
# Leave blank to disable Google login (email/password still works)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Microsoft OAuth (uncomment to enable)
#MICROSOFT_CLIENT_ID=your-azure-app-client-id
#MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
#MICROSOFT_TENANT_ID=common
#MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback

# ============================================================
# LLM PROVIDER — choose one:
#   "groq"   = Cloud (free tier, fast, no GPU needed)
#   "ollama" = Self-hosted (private, your server, needs RAM/GPU)
# ============================================================
LLM_PROVIDER=groq

# --- LLM: Groq (recommended for testing & development) ---
# Free tier: no credit card, 14,400 req/day for 8b, 500k tokens/day for 70b
# Get your key at: https://console.groq.com/keys (sign up free)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Other options:
#   llama-3.1-8b-instant          — fastest, highest free limits
#   llama-3.3-70b-versatile       — best quality for care/clinical
#   deepseek-r1-distill-llama-70b — strong reasoning

# --- LLM: Ollama (for production with self-hosted privacy) ---
# Switch to this when you have a dedicated AI server with GPU
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_TOKENS=2048

# --- Vector Database (ChromaDB) ---
CHROMA_PERSIST_DIR=/app/data/chromadb
CHROMA_COLLECTION_NAME=uk_medical_knowledge
CHROMA_DISTANCE_FUNCTION=cosine

# --- Database (PostgreSQL - user management & usage tracking) ---
DATABASE_URL=postgresql+asyncpg://careai:careai_secret@postgres:5432/careai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- Redis (rate limiting, caching, sessions) ---
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# --- Authentication ---
JWT_SECRET_KEY=change-me-to-another-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Rate Limiting ---
RATE_LIMIT_FREE_QUERIES_PER_DAY=50
RATE_LIMIT_FREE_VOICE_NOTES_PER_DAY=10
RATE_LIMIT_PRO_QUERIES_PER_DAY=0
RATE_LIMIT_PRO_VOICE_NOTES_PER_DAY=0

# --- Storage ---
MAX_STORAGE_FREE_MB=500
MAX_STORAGE_PRO_MB=5120
UPLOAD_DIR=/app/data/uploads

# --- Whisper (Speech-to-Text) ---
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=en

# --- NHS Data ---
NHS_SCRAPE_INTERVAL_HOURS=168
NHS_USER_AGENT=CareAI-Engine/1.0 (Medical Knowledge Aggregator)

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/app/logs/careai.log

# --- Monitoring ---
ENABLE_METRICS=true
METRICS_PORT=9090

# --- Stripe (Payments) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_AGENCY=price_xxx

# --- Email (for notifications) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.co.uk
SMTP_PASSWORD=xxx
