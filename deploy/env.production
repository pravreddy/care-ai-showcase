# --- GitHub (your username, lowercase) ---
GITHUB_USER=pravreddy

# --- Application ---
APP_NAME=CareAI Engine
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000
APP_HOST=0.0.0.0
APP_VERSION=1.0.0
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING_1
ALLOWED_ORIGINS=https://careaisoftware.co.uk,https://www.careaisoftware.co.uk

# --- LLM (Ollama — container name as hostname) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_TOKENS=2048

# --- Database (container name as hostname) ---
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_PASSWORD_1
DATABASE_URL=postgresql+asyncpg://careai:CHANGE_ME_TO_A_RANDOM_PASSWORD_1@postgres:5432/careai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- Redis (container name as hostname) ---
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL=3600

# --- Authentication ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING_2
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MCP ---
MCP_NHS_ENABLED=true
MCP_NHS_REQUEST_TIMEOUT=15

# --- Whisper ---
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=en

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/careai.log

# --- Stripe (add when ready) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_AGENCY=price_...

# --- Admin ---
# Your email here gets admin privileges (can create coupons, view stats)
ADMIN_EMAILS=admin@careaisoftware.co.uk
