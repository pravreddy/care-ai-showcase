# =============================================================
# SignSimple — Production Environment
# =============================================================
# Copy to .env.signsimple and fill in real values
# =============================================================

DJANGO_SETTINGS_MODULE=core.settings
DEBUG=False
ALLOWED_HOSTS=signsimple.co.uk,www.signsimple.co.uk

SECRET_KEY=CHANGE_ME_django_secret_key

# Database (shared PostgreSQL, different database name)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=docsign_uk
DB_USER=careai
DB_PASSWORD=CHANGE_ME_same_as_main_env

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Email (temporary — use Brevo free tier until Postal is ready)
DEFAULT_FROM_EMAIL=noreply@signsimple.co.uk
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-brevo-smtp-login
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
EMAIL_USE_TLS=True

# Google OAuth (SignSimple)
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-secret
GOOGLE_REDIRECT_URI=https://signsimple.co.uk/accounts/google/login/callback/

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Storage (local for now, switch to Cloudflare R2 later)
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
