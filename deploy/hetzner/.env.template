# =============================================================
# Avyangah Technologies — Hetzner Production Environment
# =============================================================
# Copy to .env and fill in your values.
# Each section can be pointed to a remote server when splitting.
# =============================================================

# --- GitHub Container Registry ---
GITHUB_USER=your-github-username
GITHUB_TOKEN=ghp_your_token_here

# --- Domains ---
DOCSIGN_DOMAIN=signsimple.co.uk
CAREAI_DOMAIN=careaisoftware.co.uk

# --- Mailcow hostname ---
# TEST PHASE:  mail.guhya.co.in   (test with this domain first)
# PRODUCTION:  mail.signsimple.co.uk  (switch after testing is complete)
MAIL_DOMAIN=mail.guhya.co.in
MAIL_TEST_DOMAIN=guhya.co.in

# =============================================================
# INFRASTRUCTURE (shared — move these to separate server later)
# =============================================================

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=avyangah
DB_PASSWORD=change_me_strong_password_here
DB_NAME=avyangah

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================
# CARE AI ENGINE
# =============================================================

LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (future — GPU server)
OLLAMA_HOST=ollama
OLLAMA_MODEL=llama3.2:3b

# =============================================================
# SIGNSIMPLE (DOCSIGN)
# =============================================================
# Most SignSimple vars go in .env.docsign (same as current setup)

# =============================================================
# MAILCOW (SELF-HOSTED EMAIL SERVER)
# =============================================================
# Mailcow runs its own docker-compose at /opt/mailcow-dockerized
# Connected to avyangah-net so Caddy can reverse proxy to it
#
# Setup: sudo bash setup-mailcow.sh mail.guhya.co.in
# Admin: https://mail.guhya.co.in (admin / moohoo — change on first login)
# Webmail: https://mail.guhya.co.in/SOGo
#
# TESTING with guhya.co.in first, then migrate:
#   1. guhya.co.in ← test here (no Zoho to break)
#   2. signsimple.co.uk ← migrate from Zoho after testing
#   3. careaisoftware.co.uk ← migrate from Zoho after testing

# Django apps send mail through Mailcow SMTP:
SMTP_HOST=mail.guhya.co.in
SMTP_PORT=587
SMTP_USER=noreply@guhya.co.in
SMTP_PASSWORD=change_me_mailbox_password
SMTP_FROM=noreply@guhya.co.in

# =============================================================
# TEMPORARY SMTP (until Mailcow is ready)
# =============================================================
# Use Brevo free tier or Gmail SMTP for transactional emails
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASSWORD=your-brevo-smtp-key
# SMTP_FROM=noreply@signsimple.co.uk
