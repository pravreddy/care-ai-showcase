# ============================================================
# Care AI - Production Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# --- GitHub (for GHCR image pulls) ---
GITHUB_USER=your-github-username

# --- Application ---
APP_ENV=production
APP_DEBUG=false
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# --- Database ---
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://careai:SAME_PASSWORD_AS_ABOVE@postgres:5432/careai

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Ollama (runs inside Docker network) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (your domain) ---
ALLOWED_ORIGINS=https://yourdomain.co.uk,https://www.yourdomain.co.uk

# --- MCP ---
MCP_NHS_ENABLED=true

# --- Whisper ---
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=en

# --- Logging ---
LOG_LEVEL=INFO

# --- Stripe (add when ready) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
